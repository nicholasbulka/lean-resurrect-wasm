// Coarse Lezer grammar for Lean 4.27.
//
// Reference: docs/lean4-reference/grammar-reference-v4.27.md
// Vendored source: vendor/lean4-src/src/Lean/Parser/Command.lean
//
// Phase 3c: structural enclosure of declarations. Each top-level command
// (Declaration, NamespaceCmd, NotationCmd, MetaCmd, HashCmd) wraps its
// keyword + body. Body absorbs token-level content until the next
// top-level start keyword — giving fold extents and outline anchor
// points to later phases (3e, 3g) without trying to parse expressions.

@top File { topItem* }

topItem {
  LineComment |
  ModuleDocComment |
  DocBlockComment |
  BlockComment |
  Declaration |
  NamespaceCmd |
  NotationCmd |
  MetaCmd |
  HashCmd
}

// === Top-level command shapes ===
// Each command consumes its starting keyword(s) and absorbs body tokens
// until the next top-level start. Modifier keywords precede a Declaration
// and are part of it.

Declaration {
  modifierKeyword* declarationKeyword bodyToken*
}

NamespaceCmd {
  namespaceKeyword bodyToken*
}

NotationCmd {
  notationKeyword bodyToken*
}

MetaCmd {
  metaKeyword bodyToken*
}

HashCmd {
  hashCommand bodyToken*
}

// === Body tokens ===
// Any token that does NOT begin a new top-level item. This is the
// terminator-by-exclusion approach — it relies on declaration / modifier
// / namespace / notation / meta / hashCommand keywords being reserved
// (i.e., the parser never produces them mid-expression). In real Lean
// they ARE reserved, so this works for top-level structure.

// Comments NOT included here: shift/reduce ambiguity with comment as a
// top-level item. Practically: a comment inside a declaration body will
// close the body and start a new top-level item. Tokenization is still
// correct (the comment is recognized as such); structural ranges
// (Declaration nodes) are slightly conservative — fold extents in 3e
// will stop at the comment. Acceptable trade-off for 3c; revisit with
// @precedence if it bites.
bodyToken {
  controlKeyword |
  Identifier |
  HashIdent |
  Number |
  StringLit |
  CharLit |
  Operator |
  Punct |
  SinglePunct |
  Other
}

// === Keywords (specialized from Identifier) ===

declarationKeyword {
  kw<"def"> | kw<"theorem"> | kw<"lemma"> | kw<"example"> |
  kw<"instance"> | kw<"class"> | kw<"structure"> |
  kw<"inductive"> | kw<"coinductive"> | kw<"abbrev"> |
  kw<"axiom"> | kw<"opaque"> | kw<"mutual">
}

modifierKeyword {
  kw<"private"> | kw<"public"> | kw<"protected"> |
  kw<"noncomputable"> | kw<"unsafe"> | kw<"partial"> |
  kw<"nonrec"> | kw<"meta">
}

namespaceKeyword {
  kw<"namespace"> | kw<"section"> | kw<"end"> |
  kw<"open"> | kw<"export"> | kw<"variable"> |
  kw<"include"> | kw<"omit"> | kw<"universe"> |
  kw<"import"> | kw<"deriving">
}

controlKeyword {
  kw<"if"> | kw<"then"> | kw<"else"> |
  kw<"match"> | kw<"with"> | kw<"fun"> |
  kw<"do"> | kw<"return"> | kw<"let"> | kw<"have"> |
  kw<"for"> | kw<"in"> | kw<"unless"> |
  kw<"try"> | kw<"catch"> |
  kw<"by"> | kw<"calc"> | kw<"show"> | kw<"suffices"> |
  kw<"where"> |
  kw<"sorry">
}

notationKeyword {
  kw<"notation"> | kw<"infix"> | kw<"infixl"> | kw<"infixr"> |
  kw<"prefix"> | kw<"postfix">
}

metaKeyword {
  kw<"syntax"> | kw<"macro"> | kw<"macro_rules"> |
  kw<"elab"> | kw<"elab_rules"> | kw<"attribute"> |
  kw<"set_option"> | kw<"initialize">
}

hashCommand {
  hashCmd<"#check"> | hashCmd<"#eval"> | hashCmd<"#eval!"> |
  hashCmd<"#synth"> | hashCmd<"#print"> | hashCmd<"#where"> |
  hashCmd<"#exit"> | hashCmd<"#reduce"> | hashCmd<"#find">
}

kw<term> { @specialize[@name={term}]<Identifier, term> }
hashCmd<term> { @specialize[@name={term}]<HashIdent, term> }

// === Tokens ===

// External tokenizer declared FIRST so Lezer iterates it before the regex
// TokenGroup. Once a tokenizer (without `extend`) matches at a position,
// the loop in @lezer/lr's getActions breaks; later tokenizers never run.
// Order in the grammar file maps to order in parser.tokenizers.
@external tokens blockComment from "./lean.tokens.js" {
  BlockComment, DocBlockComment, ModuleDocComment
}

@tokens {
  // Identifiers — letter (or _) then letters/digits/_/'/!/?, with optional
  // dotted continuation for qualified names (Foo.Bar.baz). Lean's lexer
  // treats Foo.Bar.baz as a single ident; we match that for accuracy.
  //
  // Unicode coverage:
  //  - Greek lowercase α-ω, uppercase Α-Ω
  //  - Math double-struck letter symbols (ℕ, ℤ, ℚ, ℝ, ℂ, ...)
  //  - Subscript digits ₀-₉ and letters (Lean idents like `a₁`, `x₂`)
  //  - Superscript digits and a few common letters (uses in Lean idents)
  //  - Mathematical Alphanumeric Symbols (𝓕, 𝐞, etc., U+1D400-U+1D7FF)
  Identifier {
    identSeg ("." identSeg)*
  }
  identSeg {
    identStart identCont*
  }
  identStart {
    $[a-zA-Z_]
    | $[α-ωΑ-Ω]
    | $[ℕℤℚℝℂℙℍ𝔸𝔹𝔻𝔼𝔽𝔾𝕀𝕁𝕂𝕃𝕄𝕆𝕊𝕋𝕌𝕍𝕎𝕏𝕐]
    | $[\u{1D400}-\u{1D7FF}]
  }
  identCont {
    $[a-zA-Z0-9_'!?]
    | $[α-ωΑ-Ω]
    | $[ℕℤℚℝℂℙℍ]
    | $[\u{2070}-\u{209F}]
    | $[\u{1D400}-\u{1D7FF}]
  }

  HashIdent { "#" $[a-zA-Z_]+ "!"? }

  LineComment { "--" ![\n]* }

  // Block comment forms (BlockComment, DocBlockComment, ModuleDocComment)
  // are emitted by the external tokenizer below — they nest, which a regex
  // tokenizer can't model.

  Number {
    "0" $[xX] $[0-9a-fA-F_]+ |
    "0" $[bB] $[01_]+ |
    "0" $[oO] $[0-7_]+ |
    $[0-9] $[0-9_]* ("." $[0-9] $[0-9_]*)? ($[eE] $[+\-]? $[0-9] $[0-9_]*)?
  }

  StringLit { '"' (!["\\] | "\\" _)* '"' }

  CharLit { "'" (!['\\] | "\\" _) "'" }

  // '/' and '-' live in Punct (not Operator) so block/line comments win
  // by being more specific multi-char tokens.
  Operator {
    ":=" | "=>" | "->" | "<-" | "..." | ".." |
    "→" | "←" | "↦" | "⊢" | "∀" | "∃" | "∧" | "∨" | "¬" |
    "≤" | "≥" | "≠" | "∈" | "∉" | "⊆" | "⊇" |
    $[+*%<>=!&|^~?:]+
  }

  // Note: '/' and '-' are NOT in this class. They live unmatched in the
  // regex tokenizer so the external tokenizer (declared below) gets first
  // crack at /- and -- sequences. Bare '/' or '-' fall to SinglePunct.
  Punct {
    $[(){}\[\];,@.\\`] | "⟨" | "⟩" | "⦃" | "⦄" | "«" | "»" | "_"
  }
  // SinglePunct catches any '/' or '-' that the external tokenizer (block
  // comments) and the LineComment regex (--) didn't consume.
  SinglePunct { $[/\-] }

  whitespace { $[ \t\r\n]+ }

  // Last-resort catchall so unrecognized Unicode (math letters, bullets,
  // centered-dot, etc.) doesn't produce parser errors. Any token matched
  // here can later be reclassified by extending Identifier/Operator/Punct
  // ranges.
  Other { ![ \t\r\n] }

  @precedence {
    LineComment,
    StringLit, CharLit,
    Number, HashIdent, Identifier,
    Operator, Punct, SinglePunct, Other
  }
}

@skip { whitespace }
