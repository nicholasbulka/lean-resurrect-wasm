+
+void uv__platform_loop_delete(uv_loop_t* loop) {
+  (void)loop;
+}
+
+void uv__platform_invalidate_fd(uv_loop_t* loop, int fd) {
+  (void)loop;
+  (void)fd;
+}
+
+int uv__io_check_fd(uv_loop_t* loop, int fd) {
+  (void)loop;
+  (void)fd;
+  return 0;
