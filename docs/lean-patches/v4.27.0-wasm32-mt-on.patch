 else()
diff --git a/src/lakefile.toml.in b/src/lakefile.toml.in
index 51f1c946..dbf4a6ca 100644
--- a/src/lakefile.toml.in
+++ b/src/lakefile.toml.in
@@ -44,6 +44,12 @@ nativeLibDir = "lib/lean"
 # For example, CI will set `-DwarningAsError=true` through this
 moreLeanArgs = [${LEAN_EXTRA_OPTS_TOML}]
 
+# Lake invokes its toolchain's C compiler directly (not via leanc.sh wrapper)
+# when building .c.o.export. The leanc.sh wrapper's -pthread / -matomics /
+# -mbulk-memory flags don't propagate. Force them here so every .c.o.export
+# object has the wasm features required for a -sSHARED_MEMORY link.
+moreLeancArgs = ${LEAN_EXTRA_LEANC_OPTS_TOML}
+
 # Uncomment to limit number of reported errors further in case of overwhelming cmdline output
 #weakLeanArgs = ["-DmaxErrors=1"]
 
