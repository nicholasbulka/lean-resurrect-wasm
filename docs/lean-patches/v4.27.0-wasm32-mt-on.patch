+uint64_t uv__hrtime(uv_clocktype_t type) {
+  struct timespec t;
+  (void)type;
+  if (clock_gettime(CLOCK_MONOTONIC, &t) != 0) return 0;
+  return (uint64_t)t.tv_sec * 1000000000ULL + (uint64_t)t.tv_nsec;
+}
+")
