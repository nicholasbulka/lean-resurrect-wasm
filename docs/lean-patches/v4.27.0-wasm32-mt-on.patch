+# Surface emcc wasm-features flags (-pthread -matomics -mbulk-memory) to
+# Lake via lakefile.toml moreLeancArgs. Lake calls the toolchain's C compiler
+# directly for .c.o.export and bypasses leanc.sh, so we need this hook.
+if(${CMAKE_SYSTEM_NAME} MATCHES "Emscripten" AND MULTI_THREAD)
+  set(LEAN_EXTRA_LEANC_OPTS_TOML "[\"-pthread\", \"-matomics\", \"-mbulk-memory\"]")
+else()
+  set(LEAN_EXTRA_LEANC_OPTS_TOML "[]")
+endif()
