+// MT=OFF synchronous fallback: no task manager, no dependents queued (since
+// all spawns are eager via lean_task_pure). Set the value on the underlying
+// task token directly and free the imp.
+static void lean_promise_resolve_sync(lean_task_object * t, object * v) {
+    lean_assert(t->m_value == nullptr);
+    mark_mt(v);
+    t->m_value = v;
+    lean_task_imp * imp = t->m_imp;
+    t->m_imp = nullptr;
+    if (imp) free_task_imp(imp);
+}
