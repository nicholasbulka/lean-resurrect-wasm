# ---- Third-party toolchain (huge, fetchable) ----
# vendor/ holds the Lean 4.15.0 wasm32 release tarball (~200 MB), its
# ~800 MB extracted tree, and a full lean4 source clone (~700 MB with its
# own .git). Keep these out of the repo; reproducibility comes from
# pinning the version in scripts/README, not from committing binaries.
vendor/

# ---- Node dependencies & lockfiles ----
# node_modules is always regenerable from the lockfile.
# Keep package-lock.json / package.json tracked for reproducibility.
node_modules/
.npm/
.pnp.*
.yarn/

# ---- Build output ----
dist/
build/
out/
.vite/
.turbo/
.cache/
*.tsbuildinfo

# ---- Test output / scratch dirs ----
# Transient per-run workspaces created by harness + Playwright.
.test-scratch/
.compile-scratch/
packages/tests/test-results/
packages/tests/playwright-report/
packages/tests/blob-report/
playwright/.cache/

# ---- WASM rebuild artifacts (huge, regeneratable from Docker build) ----
# build-wasm/ holds stage0 (~700 MB) + stage1 (~3 GB) intermediate output;
# .ccache/ is the compiler cache (~400 MB). Both come back via
# scripts/docker-build.sh. logs/ is per-run build output.
build-wasm/
.ccache/
logs/

# ---- Lean build artifacts (if any slip into preflight/) ----
# .olean/.ilean/.c outputs are per-toolchain; regenerate from .lean sources.
# Track the .lean fixtures themselves.
**/build/
**/.lake/
*.olean
*.ilean
*.hash
# Keep generated .c out of git — they're huge and toolchain-specific.
preflight/**/*.c

# ---- Logs, env, secrets ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# ---- Editor / OS cruft ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Claude / local agent state ----
# Project-level CLAUDE.md is worth tracking if you add one; per-user
# local settings are not. Also exclude per-user memory + project state.
.claude/
.tmp-test/

# wasm-deps build scratch (clones + intermediate artifacts)
.build-cache/

# ---- Docker-build per-run trace artifacts ----
# build-logs/<buildId>/ holds reproducibility traces (deps.jsonl,
# events.jsonl, validation-report.json) emitted by docker/build-wasm-deps-
# entry.sh. The *.log files are already covered above; ignore the JSON
# trace files too — they're per-run, not source-of-truth.
cdn/projects/*/build-logs/*/*.jsonl
cdn/projects/*/build-logs/*/validation-report.json

# ---- Cross-compile scratch ----
# build/ holds the loose .olean tree the orchestrator writes; it's the
# source for pack-bundle.js but is multi-GB scratch, never committed.
cdn/projects/*/build/

# ---- Oversized bundles ----
# Most oleans.bundle files are small enough to track in git, but full
# Mathlib is ~4.2 GB — past GitHub's 2 GB/file limit. It's sharded into
# ~500 MB pieces (oleans.bundle.NNN) for out-of-band hosting behind a CDN.
# Ignore the monolith and every shard; the tiny manifest.json stays tracked
# as the source-of-truth record (shard list + sha256s + counts).
cdn/projects/mathlib-v4.27.0-2026-04/oleans.bundle
cdn/projects/mathlib-v4.27.0-2026-04/oleans.bundle.[0-9]*
# Same for the core base-layer bundle (closure of Mathlib.Init, ~780 MB):
# ignore the monolith and every shard; core.bundle.manifest.json and the
# tiny core-modules.json stay tracked as the source-of-truth records.
cdn/projects/mathlib-v4.27.0-2026-04/core.bundle
cdn/projects/mathlib-v4.27.0-2026-04/core.bundle.[0-9]*

# ---- nanoda-wasm-spike: large generated artifacts ----
# The full li-criterion proof export is ~458 MB (8.9M NDJSON records) — past
# GitHub's 100 MB/file limit. Regenerate with lean4export (see the spike README).
# nanoda_bin.wasm (819 KB) and toy.ndjson (18 KB) ARE tracked: the deliverable
# plus a smoke-test fixture. Build logs are ignored.
tools/nanoda-wasm-spike/li-criterion.ndjson
tools/nanoda-wasm-spike/*.log
tools/nanoda-wasm-spike/export.err
